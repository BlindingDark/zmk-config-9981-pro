#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define SYM 1
#define UPPER 2
#define MEDIA 3
#define MOUSE 4

#define SL_MO(layer) &sl_mo layer layer //tap -> sticky layer, hold -> momentary layer

&sl {
    release-after-ms = <3000>;
    };

/ {
    macros {
        single_kp: single_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        ht_once: hold_tap_once {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <450>;
            quick-tap-ms = <0>;
            bindings = <&single_kp>, <&single_kp>;
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&bt BT_CLR>;
        };
    };

    behaviors {
        td_boot_out: td_boot_out {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;           
            bindings = <&bootloader>, <&out OUT_TOG>;
        };
    };

    behaviors {
        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp SEMI>, <&to SYM>;
        };
    };

    behaviors {
        tdc_to_MEDIA: td_mute_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp C_MUTE>, <&to MEDIA>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            bindings = <&kp &kp>;
        };
    };
    
    behaviors {
    sl_mo: behavior_sl_mo {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      /* 单击优先 */
        tapping-term-ms = <450>;       /* 长按阈值 */
        bindings = <&mo &sl>;          /* hold=MO, tap=SL */
        };
    };

    behaviors {
    sk_kp: behavior_sk_kp {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      
        tapping-term-ms = <450>;       
        bindings = <&kp &sk>;          /* hold=kp, tap=sticky key */
        };
    };

    behaviors {
        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            bindings = <&kp>, <&kp>;
        };
    };

// ------------------------------------------------------------------------------------------------------------------------------------------------
// |    Shoulder Key1      |                                                                                       |    Shoulder Key2             |
// |         Call key      |     Blackberry Key    |           Trackpad           |             Back Key           |         Endcall Key          |
// |     Q      |     W    |     E     |     R     |      T      |       Y        |       U        |       I       |       O      |      P        |
// |     A      |     S    |     D     |     F     |      G      |       H        |       J        |       K       |       L      |      ←        |
// |     alt    |     Z    |     X     |     C     |      V      |       B        |       N        |       M       |       $      |    Enter      |
// |            |     aA   |     0     |                          SPACE                            |       SYM     |       aA     |               |
// |----------------------------------------------------------------------------------------------------------------------------------------------|

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
                          &mkp LCLK                                                                   &mkp RCLK
    &kp ESC                              &sk_kp LGUI LGUI                     &mkp LCLK               &kp CLCK                          &ht_once LS(TAB) TAB
    &kp Q                 &kp W          &kp E             &kp R     &kp T    &kp Y          &kp U    &kp I            &kp O            &kp P
    &kp A                 &kp S          &kp D             &kp F     &kp G    &kp H          &kp J    &kp K            &kp L            &kp BSPC
    &sk_kp LSHFT LSHFT    &kp Z          &kp X             &kp C     &kp V    &kp B          &kp N    &kp M            &sl_mo 3 3       &kp ENTER
    &sk_kp LCTRL LCTRL    &sl_mo 2 2                                          &kp SPACE               &sl_mo 1 1                        &sk_kp LALT LALT
            >;
        };


        sym_layer {

            bindings = <        
                 &kp C_VOL_DN                                                                                         &kp C_VOL_UP
    &kp PSCRN               &kp C_AC_SEARCH                       &mkp MCLK                          &kp K_BACK                        &kp K_FORWARD
    &kp HASH     &kp N1     &kp N2      &kp N3    &mt LBKT LPAR   &mt RBKT RPAR     &kp UNDER        &kp MINUS        &kp PLUS         &kp AT
    &kp STAR     &kp N4     &kp N5      &kp N6    &kp SLASH       &kp COLON         &kp SEMI         &kp APOS         &kp DQT          &kp DEL
    &kp LSHFT    &kp N7     &kp N8      &kp N9    &kp QMARK       &kp EXCL          &kp COMMA        &kp DOT          &kp DLLR         &kp ENTER
    &kp LCTRL               &kp N0                                &kp SPACE                          &to DEFAULT                       &sl_mo 2 2
            >;
        };

        upper_layer {

            bindings = <
                   &kp F14                                                                       &kp F15
    &none          &none                                           &mkp MCLK                     &kp K_BACK                  &kp K_FORWARD
    &none          &kp F1     &kp F2          &kp F3  &mt LBRC LT  &mt RBRC GT      &kp PIPE     &kp CARET       &kp PRCNT   &kp AMPS
    &none          &kp F4     &kp F5          &kp F6  &kp BSLH     &kp KP_EQUAL     &kp TILDE    &kp GRAVE       &none       &kp DEL
    &kp LSHFT      &kp F7     &kp F8          &kp F9  &kp F10      &kp F11          &kp F12      &none           &none       &kp ENTER
    &kp LCTRL                 &to DEFAULT                          &kp  SPACE                    &to DEFAULT                 &kp LALT
            >;
        };

        media_layer {

            bindings = <
                      &none                                                                           &none
    &bt BT_SEL 0                &bt BT_SEL 1                                &td0                      &bt BT_SEL 2                    &bt BT_SEL 3
    &kp PG_UP         &kp UP    &kp PG_DN         &none    &none            &none             &none   &none           &sys_reset      &ext_power  EP_TOG
    &kp LEFT          &kp DOWN  &kp RIGHT         &none    &rgb_ug RGB_BRD  &rgb_ug RGB_BRI   &none   &none           &none           &td_boot_out
    &msc SCRL_LEFT    &none     &msc SCRL_RIGHT   &none    &bl BL_DEC       &bl BL_INC        &none   &none           &to DEFAULT     &none
    &none                       &none                                       &rgb_ug RGB_TOG           &to DEFAULT                     &to DEFAULT
            >;
        };

        mouse_layer {

            bindings = <
                    &mkp LCLK                                                                     &mkp RCLK
    &none                            &none                    &to DEFAULT                         &kp K_BACK                        &kp K_FORWARD
    &none           &msc SCRL_UP     &none             &none  &none        &none  &none           &mmv MOVE_UP    &none             &none
    &msc SCRL_LEFT  &msc SCRL_DOWN   &msc SCRL_RIGHT   &none  &none        &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &none
    &kp LSHFT       &none            &none             &none  &none        &none  &none           &none           &none             &none
    &kp LCTRL                        &to DEFAULT              &mkp MCLK                           &to DEFAULT                       &kp LALT
            >;
        };
    };
};
